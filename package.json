{
  "name": "mgm-bms",
  "version": "3.0.0",
  "private": true,
  "description": "MGM BMS – JK BMS Bluetooth monitör ve ayar uygulaması (Android)",
  "scripts": {
    "build:www": "python3 tools/build_www.py && esbuild src/cap-entry.js --bundle --format=iife --minify --outfile=www/vendor/cap.js",
    "sync": "npm run build:www && npx cap sync android",
    "apk": "npm run sync && cd android && ./gradlew assembleDebug"
  },
  "dependencies": {
    "@capacitor-community/bluetooth-le": "8.3.0",
    "@capacitor/android": "8.5.3",
    "@capacitor/core": "8.5.3",
    "@capacitor/filesystem": "8.1.5",
    "@capacitor/share": "8.0.3"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.3",
    "esbuild": "^0.25.0"
  }
}
